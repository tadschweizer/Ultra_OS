# TEMPLATE ONLY. Replace placeholders in a private environment file or Preview settings.
# All database, Stripe, email and OAuth resources must belong to isolated staging.
APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://your-isolated-staging.example
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SESSION_COOKIE_SECRET=replace-with-a-new-long-random-staging-secret
SUPABASE_STAGING_PROJECT_REF=replace-with-exact-20-character-staging-project-ref
# Opt in temporarily only after checking the isolated database identity.
ALLOW_DEMO_SEED=false
STRIPE_SECRET_KEY=replace-with-stripe-test-secret
STRIPE_WEBHOOK_SECRET=replace-with-isolated-webhook-signing-secret
STRIPE_PRICE_CORE_MONTHLY=replace-with-test-price-id
STRIPE_PRICE_CORE_ANNUAL=replace-with-test-price-id
STRIPE_PRICE_PRO_MONTHLY=replace-with-test-price-id
STRIPE_PRICE_PRO_ANNUAL=replace-with-test-price-id
# Legacy price keys below preserve existing-subscription mapping, not new sales.
STRIPE_PRICE_RESEARCH_MONTHLY=replace-with-test-price-id
STRIPE_PRICE_INDIVIDUAL_MONTHLY=replace-with-test-price-id
STRIPE_PRICE_INDIVIDUAL_ANNUAL=replace-with-test-price-id
# Configure test email delivery and OAuth callbacks separately for this environment.
