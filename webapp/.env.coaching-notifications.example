# Server-only. Start disabled; enable only after migration/provider/scheduler setup.
COACHING_NOTIFICATIONS_ENABLED=false
COACHING_NOTIFICATION_WORKER_SECRET=
# Existing verified Resend sender: Threshold <hello@mythreshold.co>
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
# Exact public HTTPS URL configured in Twilio; signature validation uses this value.
TWILIO_INBOUND_WEBHOOK_URL=https://mythreshold.co/api/coaching-notifications/sms-events
